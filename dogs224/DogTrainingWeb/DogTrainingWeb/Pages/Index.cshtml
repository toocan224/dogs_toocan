@page
@model IndexModel
@{
    ViewData["Title"] = "Dog Training Scheduler";
}

<div class="text-center">
    <h1 class="display-4">Dog Training Schedule</h1>
    
    <form method="post">
        <div class="form-group">
            <label>Время начала (HH:mm):</label>
            <input asp-for="Schedule.StartTime" type="time" class="form-control" required />
        </div>

        <div class="form-group">
            <label>Тип тренировки:</label>
            <select asp-for="Schedule.TrainingType" 
                asp-items="Html.GetEnumSelectList<DogTrainingWeb.Models.TrainingType>()" 
                class="form-control">
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Добавить в расписание</button>
    </form>
    
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") mt-3" role="alert">
            @Model.Message
        </div>
    }
</div>