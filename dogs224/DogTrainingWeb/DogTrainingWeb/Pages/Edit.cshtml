@page "{id:long}"
@model EditModel
@using DogTrainingWeb.Models
@using DogTrainingWeb.Services

<div class="container mt-5">
    <h2>Edit Training</h2>
    <form method="post">
        <input type="hidden" asp-for="Schedule.Id" />
        <div class="form-group mb-3">
            <label>Start Time:</label>
            <input asp-for="Schedule.StartTime" type="time" class="form-control" />
        </div>
        <div class="form-group mb-3">
            <label>Type:</label>
            <select asp-for="Schedule.TrainingType" asp-items="Html.GetEnumSelectList<TrainingType>()" class="form-control"></select>
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-page="./Manage" class="btn btn-outline-pink">Cancel</a>
    </form>
</div>